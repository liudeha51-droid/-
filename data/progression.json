  "level_formula": {
    "description": "Faith needed to go from level L to L+1.",
    "expression": "round(200 + 40*L + 3.5*L^2 + 0.08*L^3)",
    "coefficients": {
      "a": 200,
      "b": 40,
      "c": 3.5,
      "d": 0.08
    },
    "notes": "Tuned so the critical path (about 260k Faith gathered, spending all of it) finishes near level 45. Offering Faith to the Wayside God instead of levelling is the intended cost of the true ending."
  },
